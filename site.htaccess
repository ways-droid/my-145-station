# Dossier du site (ex. test) : sert index.html quand on ouvre le dossier lui-même.
# Le serveur ne trouvait pas toujours la page d'accueil du dossier (403 « Forbidden » sur /erp-test ou /erp-test/).
RewriteEngine On
# /erp-test → /erp-test/ (sinon les chemins relatifs js/… seraient faux)
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_URI} !/$
RewriteRule ^(.*)$ %{REQUEST_URI}/ [R=301,L]
# /erp-test/ → index.html
RewriteRule ^$ index.html [L]

# La page d'accueil n'est jamais gardée en cache : elle pointe vers les scripts de la dernière version (?v=…)
<IfModule mod_headers.c>
<FilesMatch "^(index\.html)?$">
Header set Cache-Control "no-cache, must-revalidate"
</FilesMatch>
</IfModule>
